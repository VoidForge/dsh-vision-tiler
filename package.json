{
  "name": "dsh-vision-tiler",
  "version": "0.3.0",
  "description": "Loss-aware, full-coverage image tiling for DeepSeek Harness vision models",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "vision",
    "ocr",
    "document-ai",
    "image-tiling"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoidForge/dsh-vision-tiler.git"
  },
  "bugs": {
    "url": "https://github.com/VoidForge/dsh-vision-tiler/issues"
  },
  "homepage": "https://github.com/VoidForge/dsh-vision-tiler#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "experiment": "npm run build && node --experimental-strip-types experiment/run.ts",
    "experiment:deepseek": "npm run build && node --experimental-strip-types experiment/run-deepseek.ts",
    "experiment:matrix": "npm run build && node --experimental-strip-types experiment/run-matrix.ts",
    "experiment:generate-dense": "node --experimental-strip-types experiment/generate-dense.ts",
    "experiment:dense": "npm run build && node --experimental-strip-types experiment/run-dense.ts",
    "analyze:dense": "node --experimental-strip-types experiment/analyze-dense.ts",
    "analyze:matrix": "npm run build && node --experimental-strip-types experiment/analyze-matrix.ts",
    "pack:plugin": "npm pack",
    "prepack": "npm run build && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "exifr": "7.1.3",
    "jimp": "1.6.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm-deepseek": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.10.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
