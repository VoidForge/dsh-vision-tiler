{
  "name": "@local/dsh-vision-tiler",
  "version": "0.2.0",
  "private": true,
  "description": "Loss-aware image tiling plugin for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "experiment": "npm run build && node --experimental-strip-types experiment/run.ts",
    "experiment:deepseek": "npm run build && node --experimental-strip-types experiment/run-deepseek.ts",
    "experiment:matrix": "npm run build && node --experimental-strip-types experiment/run-matrix.ts",
    "experiment:generate-dense": "node --experimental-strip-types experiment/generate-dense.ts",
    "experiment:dense": "npm run build && node --experimental-strip-types experiment/run-dense.ts",
    "analyze:dense": "node --experimental-strip-types experiment/analyze-dense.ts",
    "analyze:matrix": "npm run build && node --experimental-strip-types experiment/analyze-matrix.ts",
    "pack:plugin": "npm pack",
    "prepare": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "sharp": "^0.34.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@types/node": "^24.10.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
